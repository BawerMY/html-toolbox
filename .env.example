# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio, ...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key
# Default model for new tools. Selectable models are listed in config/models.json.
LLM_MODEL=qwen/qwen3-coder-flash

MONGODB_URI=mongodb://127.0.0.1:27018/html-toolkit

# Sampling temperature for every model (lower = more consistent). Unset = provider default.
LLM_TEMPERATURE=0.2
