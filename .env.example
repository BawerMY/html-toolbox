# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio, ...)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key
# The model everyone uses unless they add their own key in Settings.
LLM_MODEL=deepseek/deepseek-v4-flash

MONGODB_URI=mongodb://127.0.0.1:27018/html-toolkit

# Sampling temperature for every model (lower = more consistent). Unset = provider default.
LLM_TEMPERATURE=0.2

# Auth (Better Auth). Also used to encrypt users' saved API keys: changing it makes saved keys unreadable.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3456
# Reasoning effort for the default model (none|low|medium|high). Unset = provider default.
LLM_REASONING=low
